{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60,
        "memory": 1024
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "includeFiles": [
    "claim_js/claim.wasm",
    "circuits/claim_final.zkey",
    "circuits/verification_key.json"
  ]
}
